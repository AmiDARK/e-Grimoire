;
; Structure du système de librairies AmigaGS :
;


AmigaGS.exe							NOYAU DE A.G.S.
	|
	|-> AGS_Graphics.library		Noyau GRAPHISME de A.G.S.
	|	|
	|	|-> Display.library			Selected ECS/AGA/CGX display.
	|	|-> Screens.library			Selected Screen routines.
	|	|-> Draws.library			Selected 2D drawings functions.
	|	|-> BOB.library				Selected BOB library.
	|	|-> 3D.library				Selected 3D functions library.
	|	|-> Chunky.library			Selected Chunky convert library.
	|	|-> ...						...
	|
	|-> AGS_Sound.library			Noyau SONS de A.G.S.
	|	|
	|	|-> SoundCard.library		Selected sound device library.
	|	|-> Compress.library		Sound compression library.
	|	|	|
	|	|	|-> mpeg.library		compression en mpeg
	|	|	|-> iff.library			compression en iff/8svx/...
	|
	|-> AGS_Miscellaneous.library	Noyau DIVERS de A.G.S.
	|	|
	|	|-> memoryaccess.library	Selected Blitter/cpu040/...
	|
	|-> AGS_IO.library				Noyau Entrées/Sorties de A.G.S.
	|	|
	|	|-> Joystick.library		Selected Joystick type.
	|	|-> Mouse.library			Selected mouse type.
	|	|-> Keyboard.library		Selected keyboard type.
	|	|-> Parallel.library		Selected Parallel mode.
	|	|-> Serial.library			Selected Serial mode.
	|
	|-> AGS_Extends.library			Noyau	Extensions de A.G.S.
	|	|
	|	|-> 3d_accelerator.library	Selected 3d card accelerator.
	|	|-> Printer.library			Selected printer.
	|	|-> Scanner.library			Selected scanner.
