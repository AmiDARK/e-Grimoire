; ******************************** Compiles grimoire-core.library ********************************
Echo " "
SET sourceName libsrc/coreLib/coreLib.asm
SET compName System/grimoire-core.library
SET labelName grimoire-core.library
SET logsName logs/grimoire-core.logs
Echo "============> Build : $labelName"
; Build : $labelName
IF EXISTS $compName
  Delete $compName >NIL:
  Echo previous '$labelName' deleted
ENDIF
Echo Compiles '$labelName'
FAILAT 31
c/genam FROM $sourceName TO $compName >$logsName
SET temp1 $RC
IF VAL $temp1 EQ 0
  Echo Library '$labelName' compiled successfully
  Delete $logsName >NIL:
ELSE
  Echo Library '$labelName' returned compilation error '$temp1', please check $logsName file for details.
  QUIT
ENDIF

