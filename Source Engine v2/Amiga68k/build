Echo *************************************************
Echo * Grimoire Build-Core libraries script Ver 0.1a *
Echo *************************************************
Echo Credits : Frederic Cordier Aka AmiDARK
Echo Date : 2022.04.26
Echo " "

; ******************************** Compiles BasicChecking.exe ********************************
Echo " "
SET sourceName BasicChecking.asm
SET compName BasicChecking.exe
SET labelName BasicChecking.exe
SET logsName logs/BasicChecking.exe.logs
Echo "============> Build : $labelName"
; Build : $labelName
IF EXISTS $compName
  Delete $compName >NIL:
  Echo previous '$labelName' deleted
ENDIF
Echo Compiles '$labelName'
FAILAT 31
c/genam FROM $sourceName TO $compName >$logsName
IF VAL $RC EQ 0
  Echo Library '$labelName' compiled successfully
  Delete $logsName >NIL:
ELSE
  Echo Library '$labelName' returned compilation error(s), please check $logsName file for details.
  QUIT
ENDIF

