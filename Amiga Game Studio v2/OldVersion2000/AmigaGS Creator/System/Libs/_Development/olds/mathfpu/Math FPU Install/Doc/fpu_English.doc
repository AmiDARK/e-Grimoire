	6>Instructions :
	----------------

mf_flt()	: Convert an integer as float.
				In 	: d0 ( int )
				Out : d0 ( flt )

mf_fix()	: Convert a floating number as integer.
				In	: d0 ( flt )
				Out	: d0 ( int )

mf_abs()	: Calculate absolute of a number
				In	: d0 ( flt )
				Out : d0 ( flt )

mf_int()	: calculate integer of a number
				In	: d0 ( flt )
				Out : d0 ( flt )

mf_add()	: adding 2 floating numbers
				In 	: d0,d1 ( flt )
				Out	: d0	( flt ) d0+d1->d0

mf_sub()	: substract 2 floating numbers
				In 	: d0,d1 ( flt )
				Out	: d0	( flt ) d0-d1->d0

mf_mul()	: multiply 2 floating numbers
				In 	: d0,d1 ( flt )
				Out	: d0	( flt ) d0*d1->d0

mf_div()	: divide 2 floating numbers
				In 	: d0,d1 ( flt )
				Out	: d0	( flt ) d0/d1->d0

mf_cmp()	: compare 2 floating registers
				In	: d0,d1 ( flt )
				Out : FPU States registers
				( Use FPU registers like FBeq.? instead of Beq.? )

mf_neg()	: Calculate the negative of a floating number
				In	: d0 ( flt )
				Out : d0 ( flt )	-d0 -> d0

mf_tst()	: Compare with 0
				In	: d0 ( flt )
				Out : FPU States registers
				( Use FPU registers like FBeq.? instead of Beq.? )

mf_cos()	: Calculate a cosinus
				In	: d0 ( flt )
				Out : d0 ( flt ) cos(d0)->d0

mf_sin()	: Calculate a sinus
				In	: d0 ( flt )
				Out : d0 ( flt ) sin(d0)->d0

mf_tan()	: Calculate a tangent
				In	: d0 ( flt )
				Out : d0 ( flt ) tan(d0)->d0

mf_sincos()	: Calculate a cosinus and sinus
				In	: d0 ( flt )
				Out : d0,d1 ( flt ) cos(d0)->d0 , sin(d0)->d1

mf_acos()	: Calculate an arc-cosinus
				In	: d0 ( flt )
				Out : d0 ( flt ) acos(d0)->d0

mf_asin()	: Calculate an arc-sinus
				In	: d0 ( flt )
				Out : d0 ( flt ) asin(d0)->d0

mf_atan()	: Calculate an arc-tangent
				In	: d0 ( flt )
				Out : d0 ( flt ) atan(d0)->d0

mf_sqrt()	: Calculate the square root of a floating number
				In	: d0 ( flt )
				Out : d0 ( flt ) sqrt(d0)->d0

mf_cosh()	: Calculate an hyperbolic-cosinus
				In	: d0 ( flt )
				Out : d0 ( flt ) cosh(d0)->d0

mf_sinh()	: Calculate an hyperbolic-sinus
				In	: d0 ( flt )
				Out : d0 ( flt ) sinh(d0)->d0

mf_tanh()	: Calculate an hyperbolic-tangent
				In	: d0 ( flt )
				Out : d0 ( flt ) tanh(d0)->d0

mf_log10()	: Calculate a logarithm base 10
				In	: d0 ( flt )
				Out : d0 ( flt ) log10(d0)->d0

mf_log2()	: Calculate a logarithm base 2
				In	: d0 ( flt )
				Out : d0 ( flt ) log10(d0)->d0

mf_logn()	: Calculate a neperian logarithm 
				In	: d0 ( flt )
				Out : d0 ( flt ) log10(d0)->d0

mf_lognp1()	: Calculate a logarithm np1 ?
				In	: d0 ( flt )
				Out : d0 ( flt ) log10(d0)->d0

