Echo ****************************************************
Echo * Grimoire Build-Examples libraries script Ver 0.1 *
Echo ****************************************************
Echo Credits : Frederic Cordier Aka AmiDARK
Echo Date : 2022.04.19
Echo " "

; ******************************** Compiles BasicChecking.exe ********************************
Echo " "
SET sourceName BasicChecking.asm
SET compName BasicChecking.exe
SET labelName BasicChecking.exe
SET logsName logs/BasicChecking.exe.logs
Echo "============> Build : $labelName"
; Build : $labelName
IF EXISTS $compName
  Delete $compName >NIL:
  Echo previous '$labelName' deleted
ENDIF
Echo Compiles '$labelName'
FAILAT 31
c/genam FROM $sourceName TO $compName >$logsName
SET temp1 $RC
IF VAL $temp1 EQ 10
  Echo Executable '$labelName' returned compilation error(s), please check $logsName file for details.
  QUIT
ELSE
  Echo Executable '$labelName' compiled successfully
ENDIF

; ******************************** Compiles BasicChecking.exe ********************************
Echo " "
